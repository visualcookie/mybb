# MyBB Docker Configuration
# Copy this file to .env and modify as needed

# MyBB version (used as build arg for docker-compose.yml)
MYBB_VERSION=1839

# Image tag for pre-built images (docker-compose.ghcr.yml)
MYBB_TAG=latest

# Web Port
MYBB_PORT=8080

# Database Configuration
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=mybb
MYSQL_USER=mybb
MYSQL_PASSWORD=change_this_password

# SFTP Configuration (optional, only when using --profile sftp or --profile tools)
# Connect with: sftp -P 2222 SFTP_USER@localhost
# Files are located in /home/SFTP_USER/mybb/
SFTP_PORT=2222
SFTP_USER=mybb
SFTP_PASSWORD=change_this_sftp_password

# phpMyAdmin Port (optional, only when using --profile tools)
PMA_PORT=8081

# Timezone
TZ=UTC

# Upgrade mode (set to true when upgrading to a new image)
# UPGRADE_MODE=true
# PRESERVE_PLUGINS=true
# PRESERVE_THEMES=true
