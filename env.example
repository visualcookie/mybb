# MyBB Docker Configuration
# Copy this file to .env and modify as needed

# MyBB Version (e.g., 1839 for v1.8.39, 1838 for v1.8.38)
# Find versions at: https://github.com/mybb/mybb/releases
MYBB_VERSION=1839

# Web Port (MyBB will be accessible at http://localhost:MYBB_PORT)
MYBB_PORT=8080

# Database Configuration
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=mybb
MYSQL_USER=mybb
MYSQL_PASSWORD=change_this_password

# SFTP Configuration (optional, only when using --profile sftp or --profile tools)
# Connect with: sftp -P 2222 SFTP_USER@localhost
# Files are located in /home/SFTP_USER/mybb/
SFTP_PORT=2222
SFTP_USER=mybb
SFTP_PASSWORD=change_this_sftp_password

# phpMyAdmin Port (optional, only when using --profile tools)
PMA_PORT=8081

# Timezone
TZ=UTC

# ===========================================
# UPGRADE MODE (for existing installations)
# ===========================================
# Set UPGRADE_MODE=true to safely upgrade MyBB
# This will:
#   - Backup your config files
#   - Download the new MYBB_VERSION
#   - Preserve uploads, themes, plugins
#   - Remind you to run /install/upgrade.php
#
# UPGRADE_MODE=true
# PRESERVE_PLUGINS=true
# PRESERVE_THEMES=true
